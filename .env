# ==============================================================================
# AraratPay - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Remote Asset CDN URL
# ------------------------------------------------------------------------------
# All heavy media files (hero videos, flow previews, cuts, high-res posters)
# are streamed from this CDN host instead of bundling ~500MB into git/public.
#
# Current Active CDN (Cloudflare R2 via Lovable edge):
VITE_ASSET_CDN_URL="https://id-preview--7af7e689-94d0-422b-b997-3561621da9f8.lovable.app"

# ------------------------------------------------------------------------------
# HOW & WHEN TO USE IN THE FUTURE:
# ------------------------------------------------------------------------------
# If you ever migrate the media assets to your own custom storage or CDN:
#   1. Upload the `__l5e/assets-v1/...` media folder to your Cloudflare R2 bucket,
#      AWS S3 + CloudFront, Supabase Storage, or BunnyCDN.
#   2. Update this variable with your own custom domain or bucket public URL.
#
# Examples:
#   VITE_ASSET_CDN_URL="https://assets.yourdomain.com"
#   VITE_ASSET_CDN_URL="https://cdn.araratpay.com"
#   VITE_ASSET_CDN_URL="https://pub-xxxxxx.r2.dev"
# ==============================================================================
